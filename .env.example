# Postgres connection string. Use Supabase's *transaction pooler* URI
# (Project Settings → Database → Connection string → "Transaction pooler", port 6543).
# Leave unset for local development: the app then uses an on-disk PGlite
# database in .data/pglite, with no setup needed.
DATABASE_URL=

# Optional: a shared household passcode, asked once per device. Leave blank
# to make the app open to anyone with the URL.
APP_PASSCODE=

# Timezone used for calendar events and reminders.
APP_TIMEZONE=Australia/Sydney

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Open Food Facts asks for an identifying User-Agent with a contact address.
OFF_USER_AGENT=Fuel/0.1 (you@example.com)

# Claude API (AI suggestions, photo-of-plate logging, nutrition panel OCR).
# Server-side only; each profile can switch AI features on in Settings.
ANTHROPIC_API_KEY=

# Web push reminders. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/reminders (call it every 15 min from a scheduler).
CRON_SECRET=
