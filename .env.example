# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service role) key — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated emails allowed to open /admin and generate invite codes.
ADMIN_EMAILS=you@example.com

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Open Food Facts asks for an identifying User-Agent with a contact address.
OFF_USER_AGENT=NutritionTracker/0.1 (you@example.com)

# Optional (Phase 5): Claude API key, server-side only.
ANTHROPIC_API_KEY=
